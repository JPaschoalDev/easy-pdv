<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="742.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.senai.controller.VendasController">
   <children>
      <ComboBox fx:id="comboCliente" layoutX="14.0" layoutY="75.0" prefWidth="150.0" promptText="CLIENTES">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </ComboBox>
      <ComboBox fx:id="comboProduto" layoutX="204.0" layoutY="75.0" prefWidth="150.0" promptText="PRODUTOS">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </ComboBox>
      <Label layoutX="261.0" layoutY="22.0">
         <font>
            <Font name="Lucida Sans Unicode" size="20.0" />
         </font>
      </Label>
      <TextField fx:id="campoQuantidade" layoutX="29.0" layoutY="331.0" prefHeight="26.0" prefWidth="174.0" promptText="QUANTIDADE DE PRODUTOS" />
      <Label layoutX="204.0" layoutY="23.0" text="CADASTRAR VENDAS">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
      <Button fx:id="botaoAdicionar" layoutX="404.0" layoutY="358.0" mnemonicParsing="false" onAction="#adicionarProduto" text="ADICIONAR AO CARRINHO">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <TableView fx:id="tabelaCarrinho" layoutX="15.0" layoutY="408.0" prefHeight="235.0" prefWidth="536.0">
        <columns>
          <TableColumn fx:id="colunaProdutoCarrinho" prefWidth="75.0" text="PRODUTO" />
          <TableColumn fx:id="colunaQuantidade" prefWidth="75.0" text="QTD" />
            <TableColumn fx:id="colunaPrecoUnitario" prefWidth="75.0" text="PREÇO UNIT" />
            <TableColumn fx:id="colunaSubtotal" prefWidth="75.0" text="SUBTOTAL" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <ComboBox fx:id="comboFormaPagamento" layoutX="380.0" layoutY="74.0" prefHeight="26.0" prefWidth="181.0" promptText="FORMA DE PAGAMENTO">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </ComboBox>
      <Label fx:id="labelValorTotal" layoutX="418.0" layoutY="312.0" prefHeight="18.0" prefWidth="105.0" />
      <Label fx:id="labelMensagem" layoutX="15.0" layoutY="374.0" prefHeight="18.0" prefWidth="324.0" />
      <Button fx:id="botaoCancelar" layoutX="45.0" layoutY="676.0" mnemonicParsing="false" onAction="#cancelarVenda" prefHeight="26.0" prefWidth="118.0" text="CANCELAR">
         <font>
            <Font size="17.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button fx:id="botaoFinalizar" layoutX="367.0" layoutY="676.0" mnemonicParsing="false" onAction="#finalizarVenda" prefHeight="26.0" prefWidth="118.0" text="FINALIZAR">
         <font>
            <Font size="17.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
   </children>
   <cursor>
      <Cursor fx:constant="DISAPPEAR" />
   </cursor>
</AnchorPane>
